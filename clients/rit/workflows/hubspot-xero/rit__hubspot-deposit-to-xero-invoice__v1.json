    },
    {
      "parameters": {
        "jsCode": "const ACCOUNTS = [\n  { accountId: 'WA1106', name: 'Secutiry Deposits (WA)' },\n  { accountId: 'VIC1106', name: 'Secutiry Deposits (VIC)' },\n  { accountId: '1106', name: 'Secutiry Deposits (Legacy)' },\n];\nconst DEFAULT_ACCOUNT_ID = '1106';\n\nfor (const item of $input.all()) {\n  let region = null;\n  try {\n    region = $('Loop Over Line Items').item.json.state ?? null;\n  } catch (e) {\n    console.log('Could not resolve item from Loop Through Line Items:', e.message);\n  }\n\n  if (region == null) {\n    console.log('⚠ No state found on the Loop Through Line Items item — region will be null.');\n  }\n\n  const matchedAccount = region ? ACCOUNTS.find((a) => a.name.includes(region)) : null;\n\n  item.json.region = region;\n  item.json.account_id = matchedAccount ? matchedAccount.accountId : DEFAULT_ACCOUNT_ID;\n}\n\nreturn $input.all();"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        7232,
        3328
      ],
      "id": "d0372ace-649f-41ff-ace8-fc9c3d120840",
      "name": "Resolve Deposit Account by State",
      "notesInFlow": true,
      "notes": "Picks the Xero deposit account from the line item's state. Falls back to 1106 (legacy)."
    },
    {
      "parameters": {
        "mode": "combineBySql",
        "numberInputs": 3,
        "query": "SELECT\n  input2.*,\n  input1.InvoiceID,\n  input3.body.state AS state\nFROM input2, input1, input3",
        "options": {}
      },
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3.2,
      "position": [
        6368,
        3296
      ],
      "id": "511dd9a9-4934-46e7-a4ee-d98399980f0b",
      "name": "Attach Invoice ID and State to Line Items"
    },
    {
      "parameters": {
        "jsCode": "// Runs once after the loop finishes (Loop Through Line Items \"done\" output, index 0).\n// Builds the full Xero LineItems array from every line item processed during the loop.\nconst items = $input.all();\n\nconst lineItems = items.map((item) => ({\n  Description: item.json.properties.asset_number + \" | Security Deposit | \" + item.json.properties.name,\n  Quantity: 8,\n  UnitAmount: parseFloat(item.json.properties.amount) / 8,\n  ItemCode: item.json.properties.asset_number,\n  AccountCode: item.json.account_id,\n  LineAmount: parseFloat(item.json.properties.amount),\n}));\n\n// InvoiceID is constant across all line items for this run - pull it from the\n// original Loop Through Line Items output, since the current items now hold the\n// HubSpot line item fetch response instead (InvoiceID doesn't survive that call).\nconst invoiceId = $('Loop Over Line Items').first().json.InvoiceID;\n\nreturn [{ json: { invoiceId, lineItems } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        7360,
        3184
