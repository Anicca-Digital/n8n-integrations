        "mode": "combineBySql",
        "numberInputs": 3,
        "query": "SELECT\n  COALESCE(\n    input1.Contacts->0->ContactID,\n    input2.properties->xero_customer_id->[value]\n  ) AS xeroContactId,\n  input3.properties->hs_purchase_order_number AS purchaseOrderNumber,\n  input3.properties->hubspot_owner_id AS ownerId,\n  input3.properties->hs_createdate AS createDate,\n  input3.properties->hs_number AS invoiceNumber,\n  input3.properties->hs_due_date AS dueDate,\n  input3.id AS invoiceId\nFROM input3\nLEFT JOIN input1 ON 1 = 1\nLEFT JOIN input2 ON 1 = 1",
        "options": {}
