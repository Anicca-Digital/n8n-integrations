      "name": "Create Fixed Asset in Xero",
      "notesInFlow": true,
      "credentials": {
        "oAuth2Api": {
          "id": "uddhyMSOvCMD5LeS",
          "name": "Xero Additional Scope"
        }
      },
      "onError": "continueErrorOutput",
      "notes": "Creates a Draft fixed asset. Failures go to Normalize Error."
