            "version": 3
          },
          "conditions": [
            {
              "id": "13243e0e-5f4e-4d78-99d9-d4e1a1c91f95",
              "leftValue": "={{ $('Get Deal Line Items').first().json.results.length > 0 }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "looseTypeValidation": true,
        "options": {}
      },
      "id": "7f63c18e-7fc9-4344-bc2b-9ce63be12c20",
      "name": "Deal Has Old Lines?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        2992,
        304
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.hubapi.com/crm/v3/objects/line_items/batch/archive",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "hubspotAppToken",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { inputs: $('Get Deal Line Items').first().json.results.map(item => ({ id: item.id })) } }}",
        "options": {}
      },
      "id": "ce2bb0ee-4f94-499a-b971-4c4c7d384cf9",
      "name": "Archive Old Line Items",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        3232,
        160
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000,
      "alwaysOutputData": true,
      "notesInFlow": true,
      "credentials": {
        "hubspotAppToken": {
          "id": "OrycIvMGQfBUOpAi",
          "name": "Plasson HubSpot"
        }
      },
      "notes": "Returns 204, so Always Output Data is on."
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "=https://api.hubapi.com/crm/v3/objects/deals/{{ $('Match Deal').first().json.deal.id }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "hubspotAppToken",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { properties: {\n  netsuite_quote_number: $('Match Deal').first().json.quoteNumber,\n  amount: $('Prepare Lines').first().json.subtotal,\n  quote_status: $('Match Deal').first().json.quoteStatus,\n  dealstage: $('Match Deal').first().json.deal.properties.quote_status === $('Match Deal').first().json.quoteStatus\n    ? $('Match Deal').first().json.deal.properties.dealstage\n    : $('Config').first().json.stageIds[$('Config').first().json.statusToStage[$('Match Deal').first().json.quoteStatus]]\n} } }}",
        "options": {}
      },
      "id": "80c2b128-81ca-4dd9-8a04-7020f3115d38",
      "name": "Update Deal",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        3472,
        304
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000,
      "notesInFlow": true,
      "credentials": {
        "hubspotAppToken": {
          "id": "OrycIvMGQfBUOpAi",
          "name": "Plasson HubSpot"
        }
      },
      "notes": "LAST write. Amount = ex-GST subtotal of the lines. Stage only moves when quote_status changed."
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "db6bc9ef-24e5-4e9c-b1ff-955ed8c0572c",
              "name": "ok",
              "value": true,
              "type": "boolean"
            },
            {
              "id": "484836d4-15ad-456e-8bc8-cd4a898f415a",
              "name": "skipped",
              "value": false,
              "type": "boolean"
            },
            {
              "id": "d37c138b-46ed-41d8-be48-86ae9d31b126",
              "name": "quoteId",
              "value": "={{ $('Match Deal').first().json.quoteId }}",
              "type": "string"
            },
            {
              "id": "344bb64f-7a52-4086-bcae-d393a40ba098",
              "name": "quoteNumber",
              "value": "={{ $('Match Deal').first().json.quoteNumber }}",
              "type": "string"
            },
            {
              "id": "3f0ee7af-f822-4d16-a212-cb7bbfccb0ae",
              "name": "dealId",
              "value": "={{ $('Match Deal').first().json.deal.id }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "354a4c0f-7f5d-4438-b67a-f1deefcf39a3",
      "name": "Finish",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        3712,
        304
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "587dfd55-e71d-42d9-bd55-a474a1eaf783",
              "name": "lines",
              "type": "array",
              "value": "={{ $json.items.map(line => ({\n  name: line.item_name || line.sku || 'NetSuite item',\n  description: line.description || '',\n  hs_sku: line.sku || '',\n  quantity: Math.abs(Number(line.quantity)),\n  price: Number(line.quantity) ? Number((Number(line.amount) / Number(line.quantity)).toFixed(4)) : Number(line.rate || 0),\n  netsuite_line_id: String(line.line_id)\n})) }}"
            },
            {
              "id": "a836c69b-51fa-404b-895a-df35846c4732",
              "name": "subtotal",
              "type": "number",
              "value": "={{ Math.round(Math.abs($json.items.reduce((sum, line) => sum + Number(line.amount || 0), 0)) * 100) / 100 }}"
            }
          ]
        },
        "options": {}
      },
      "id": "90ddb465-86fb-4859-a62d-2940885db796",
      "name": "Prepare Lines",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1792,
        304
