      "id": "4951088a-ba91-4649-8751-d8dec155bb1a",
      "name": "Schedule Every 30 Minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        384
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "4a8c0841-e899-461b-b26c-604855c939c2",
              "name": "netsuiteAccountHost",
              "value": "6798253",
              "type": "string"
            },
            {
              "id": "7a262e30-311e-4ab0-9f34-5fea4418432d",
              "name": "netsuiteTimezone",
