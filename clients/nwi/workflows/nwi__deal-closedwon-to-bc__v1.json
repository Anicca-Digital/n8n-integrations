    {
      "parameters": {
        "jsCode": "// Environment-specific values live here and nowhere else.\nconst bc = {\n  baseUrl: 'https://api.businesscentral.dynamics.com/v2.0',\n  tenantId: '0dc6b780-5b9e-4809-afb6-6bc499280f23',\n  environment: 'Production',\n  companyName: 'National Weighing & Instrument', // the company's `name`; its GUID is looked up each run\n};\nbc.companiesUrl = `${bc.baseUrl}/${bc.tenantId}/${bc.environment}/api/v2.0/companies`;\nreturn [{ json: {\n  hubspot: {\n    pipelineId: 'default',\n    triggerProperty: 'closed_won',\n    triggerValue: 'true',\n    dealProperties: 'dealname,pipeline,dealstage,amount,bc_order_id,closed_won',\n    companyProperties: 'name,address,address2,city,state,zip,country,phone,website,domain,business_central_id',\n    contactProperties: 'firstname,lastname,email,phone',\n    lineItemProperties: ['name', 'hs_sku', 'quantity', 'price'],\n  },\n  bc,\n  // HubSpot country text -> BC country/region code (2-letter codes pass through as-is).\n  countryMap: { 'australia': 'AU', 'new zealand': 'NZ', 'united states': 'US', 'united kingdom': 'GB', 'singapore': 'SG' },\n} }];\n"
      },
      "id": "c6e9f32e-1359-533e-aba2-0594e05dcfb0",
      "name": "Workflow Config",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        300
      ],
      "notesInFlow": true,
      "notes": "BC values are set."
    },
    {
      "parameters": {
        "jsCode": "// One execution per webhook call. HubSpot posts a JSON array of events; keep the \"Closed Won? ticked\" ones.\nconst hs = $('Workflow Config').first().json.hubspot;\nconst body = $('Receive HubSpot Deal Events').first().json.body;\nconst events = Array.isArray(body) ? body : [];\nconst ids = [];\nfor (const e of events) {\n  // Legacy apps send 'deal.propertyChange'; developer-platform projects send 'object.propertyChange' + objectTypeId 0-3.\n  const isDealChange = e.subscriptionType === 'deal.propertyChange'\n    || (e.subscriptionType === 'object.propertyChange' && e.objectTypeId === '0-3');\n  if (!isDealChange) continue;\n  if (e.propertyName !== hs.triggerProperty || String(e.propertyValue).toLowerCase() !== hs.triggerValue) continue;\n  const id = String(e.objectId || '').trim();\n  if (id && !ids.includes(id)) ids.push(id);\n}\nif (ids.length === 0) return [];   // not a \"ticked\" event (e.g. un-tick): end quietly\nif (ids.length > 1) {\n  // This workflow handles one deal per run. Fail loudly rather than silently drop deals.\n  throw new Error(`Webhook call carried ${ids.length} closed-won deals (${ids.join(', ')}); this workflow handles one per run.`);\n}\nreturn [{ json: { dealId: ids[0] } }];\n"
      },
