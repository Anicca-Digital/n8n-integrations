        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ ({ properties: $('Workflow Config').first().json.hubspot.lineItemProperties, inputs: $('Pick Associated Records').first().json.lineItemIds.map((id) => ({ id })) }) }}",
