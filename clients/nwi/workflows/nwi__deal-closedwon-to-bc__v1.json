      "parameters": {
        "jsCode": "// The BC ID on the HubSpot company must resolve to exactly one BC customer.\nconst found = $input.first().json.value || [];\nconst ref = $('Build Customer Payload').first().json.bcId;\nif (found.length !== 1) {\n  throw new Error(`HubSpot company has business_central_id \"${ref}\" but Business Central returned ${found.length} matching customers. Not creating a duplicate - fix the ID in HubSpot.`);\n}\nreturn [{ json: { customerId: found[0].id, customerNumber: found[0].number } }];\n"
      },
