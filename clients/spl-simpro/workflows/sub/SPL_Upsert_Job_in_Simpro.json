        "jsonBody": "={{ ({\n  properties: {\n    simpro_id: String($json.ID),\n    simpro_section_id: String($('Get Job Sections').item.json.ID),\n  },\n}) }}",
        "options": {}
      },
      "id": "9b719eb1-f7dc-49b3-b9ce-f95dc79df26b",
