    {
      "parameters": {
        "method": "={{ $('Get HubSpot Deal').first().json.properties.simpro_job_id ? 'PATCH' : 'POST' }}",
        "url": "={{ $('Workflow Config').first().json.simproJobsUrl + '/' + ($('Get HubSpot Deal').first().json.properties.simpro_job_id ?? '') }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "oAuth2Api",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ (() => {\n  const deal = $('Get HubSpot Deal').first().json.properties;\n  const input = $('When Executed by Another Workflow').first().json;\n  const isNew = !deal.simpro_job_id;\n  const asDate = (v) => /^\\d+$/.test(String(v)) ? DateTime.fromMillis(Number(v), { zone: 'utc' }) : DateTime.fromISO(String(v), { zone: 'utc' });\n  return {\n    Customer: Number(input.simpro_customer_id),\n    CustomerContact: Number(input.simpro_contact_id),\n    Site: Number(input.simpro_site_id),\n    Name: deal.dealname ?? '',\n    Description: deal.simpro_description ?? '',\n    Notes: deal.description ?? '',\n    Salesperson: Number($('Look Up Sales Person').first().json.Simpro_ID),\n    ProjectManager: Number($('Look Up Project Manager').first().json.Simpro_ID),\n    DueDate: deal.due_date ? asDate(deal.due_date).toFormat('yyyy-MM-dd') : null,\n    OrderNo: deal.orderno ?? '',\n    Tags: (deal.project_tags ?? '').split(';').filter(Boolean).map(Number),\n    ...(isNew ? { Type: deal.job_type ?? '' } : {}),\n  };\n})() }}",
        "options": {}
      },
