        "jsonBody": "={{ ({\n  filterGroups: [\n    { filters: [ { propertyName: 'simpro_job_id', operator: 'EQ', value: String($('Get Simpro Job').first().json.ID) } ] },\n  ],\n  properties: ['simpro_job_id'],\n  sorts: ['createdate'],\n  limit: 1,\n}) }}",
