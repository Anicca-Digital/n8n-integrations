      "id": "9dc484de-b72c-4425-8bcc-1a899b20d772",
      "name": "Find Deal by Simpro Job ID",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        -448,
        80
      ],
      "notesInFlow": true,
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000,
      "credentials": {
        "hubspotAppToken": {
          "id": "YLZLsLfN752HplsL",
          "name": "SPL Account"
        }
      },
      "notes": "Searches deals on simpro_job_id (oldest match first, one result). No match returns results: [] so the next node creates the deal."
    },
    {
      "parameters": {
        "method": "={{ $('Find Deal by Simpro Job ID').first().json.results?.[0] ? 'PATCH' : 'POST' }}",
        "url": "={{ 'https://api.hubapi.com/crm/objects/2026-09/deals' + ($('Find Deal by Simpro Job ID').first().json.results?.[0] ? '/' + $('Find Deal by Simpro Job ID').first().json.results[0].id : '') }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "hubspotAppToken",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ (() => {\n  const job = $('Get Simpro Job').first().json;\n  const cfg = $('Workflow Config').first().json;\n  const day = (iso) => iso ? DateTime.fromISO(iso, { zone: 'utc' }).startOf('day').toMillis() : '';\n  const stages = {\n    pending: cfg.stagePending,\n    progress: cfg.stageProgress,\n    complete: cfg.stageComplete,\n    archived: cfg.stageArchived,\n  };\n  const stageKey = String(job.Stage ?? '').trim().toLowerCase();\n  return {\n    properties: {\n      dealname: job.Name,\n      amount: job.Total?.ExTax,\n      description: job.Notes ?? '',\n      pipeline: cfg.hubspotPipelineId,\n      dealstage: stages[stageKey] ?? cfg.stageDefault,\n      hubspot_owner_id: $('Look Up Sales Person').first().json.HubSpot_ID,\n      project_manager: $('Look Up Project Manager').first().json.HubSpot_ID,\n      simpro_job_id: job.ID,\n      approved_date: day(job.DateApproved),\n      due_date: day(job.DueDate),\n      orderno: job.OrderNo ?? '',\n      simpro_description: job.Description ?? '',\n      project_tags: (job.Tags ?? []).map(tag => tag.ID).join(';'),\n      job_type: job.Type ?? '',\n    },\n  };\n})() }}",
        "options": {}
      },
