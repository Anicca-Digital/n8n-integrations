        "url": "https://api.hubapi.com/crm/objects/2026-09/deals/search",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "hubspotAppToken",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ ({\n  filterGroups: [\n    { filters: [ { propertyName: 'simpro_quote_id', operator: 'EQ', value: String($('Get Simpro Quote').first().json.ID) } ] },\n  ],\n  properties: ['simpro_quote_id'],\n  sorts: ['createdate'],\n  limit: 1,\n}) }}",
