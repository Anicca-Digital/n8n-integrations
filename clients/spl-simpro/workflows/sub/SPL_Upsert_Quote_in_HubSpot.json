      "id": "9cf25731-e079-489a-9e04-6bb4f0eb9efc",
      "name": "Find Deal by Simpro Quote ID",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        -400,
        80
      ],
      "notesInFlow": true,
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000,
      "credentials": {
        "hubspotAppToken": {
          "id": "YLZLsLfN752HplsL",
          "name": "SPL Account"
        }
      },
      "notes": "Searches deals on simpro_quote_id (oldest match first, one result). No match returns results: [] so the next node creates the deal."
    },
    {
      "parameters": {
        "method": "={{ $('Find Deal by Simpro Quote ID').first().json.results?.[0] ? 'PATCH' : 'POST' }}",
        "url": "={{ 'https://api.hubapi.com/crm/objects/2026-09/deals' + ($('Find Deal by Simpro Quote ID').first().json.results?.[0] ? '/' + $('Find Deal by Simpro Quote ID').first().json.results[0].id : '') }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "hubspotAppToken",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ (() => {\n  const quote = $('Get Simpro Quote').first().json;\n  const cfg = $('Workflow Config').first().json;\n  const day = (iso) => iso ? DateTime.fromISO(iso, { zone: 'utc' }).startOf('day').toMillis() : '';\n  const customField = (id) => (quote.CustomFields ?? []).find(f => f.CustomField?.ID === Number(id))?.Value ?? '';\n  const stages = {\n    'quote to be completed': cfg.stageToBeCompleted,\n    'quote overdue': cfg.stageToBeCompleted,\n    'quote won': cfg.stageWon,\n    'quote lost': cfg.stageLost,\n  };\n  const status = String(quote.Status?.Name ?? '').trim().toLowerCase();\n  return {\n    properties: {\n      dealname: quote.Name,\n      amount: quote.Total?.ExTax,\n      description: quote.Notes ?? '',\n      pipeline: cfg.hubspotPipelineId,\n      dealstage: stages[status] ?? cfg.stageDefault,\n      hubspot_owner_id: $('Look Up Sales Person').first().json.HubSpot_ID,\n      project_manager: $('Look Up Project Manager').first().json.HubSpot_ID,\n      simpro_quote_id: quote.ID,\n      approved_date: day(quote.DateApproved),\n      due_date: day(quote.DueDate),\n      orderno: quote.OrderNo ?? '',\n      validity: quote.ValidityDays ?? '',\n      simpro_description: quote.Description ?? '',\n      project_tags: (quote.Tags ?? []).map(tag => tag.ID).join(';'),\n      tender_number: customField(cfg.cfTenderNumber),\n      tender_status: customField(cfg.cfTenderStatus),\n      quote_type: quote.Type ?? '',\n      vertical: customField(cfg.cfVertical),\n    },\n  };\n})() }}",
        "options": {}
      },
