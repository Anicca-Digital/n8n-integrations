    },
    {
      "parameters": {
        "url": "={{ $('Workflow Config').first().json.hubspotContactsUrl }}/{{ $('When Executed by Another Workflow').first().json.hubspot_contact_id }}",
        "authentication": "predefinedCredentialType",
