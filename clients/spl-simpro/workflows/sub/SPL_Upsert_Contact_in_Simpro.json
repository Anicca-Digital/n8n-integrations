      "position": [
        -544,
        128
      ],
      "notesInFlow": true,
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000,
      "credentials": {
        "hubspotAppToken": {
          "id": "YLZLsLfN752HplsL",
          "name": "SPL Account"
        }
      },
      "notes": "Fetches the HubSpot Contact. EDIT HERE: add or remove properties in the properties query below, then add the matching line in the Simpro body."
    },
    {
      "parameters": {
        "url": "={{ $('Workflow Config').first().json.hubspotContactsUrl }}/{{ $('When Executed by Another Workflow').first().json.hubspot_contact_id }}/associations/companies",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "hubspotAppToken",
        "options": {}
      },
      "id": "9bf32175-5aa2-4346-968a-ec5b82d3febb",
      "name": "Get Associated Company",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        -336,
        128
      ],
      "notesInFlow": true,
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000,
      "credentials": {
        "hubspotAppToken": {
          "id": "YLZLsLfN752HplsL",
          "name": "SPL Account"
        }
      },
      "notes": "Every company associated with the contact (results[]). The first one is used as the Simpro customer. ⚠ A contact with no company leaves results empty and the next node fails."
    },
    {
      "parameters": {
        "workflowId": {
          "__rl": true,
          "value": "rjRxp1RRbXkKoPkk",
          "mode": "list",
          "cachedResultUrl": "/workflow/rjRxp1RRbXkKoPkk",
          "cachedResultName": "[SPL] Upsert Company in Simpro"
        },
        "workflowInputs": {
          "mappingMode": "defineBelow",
          "value": {
            "hubspot_comapny_id": "={{ $json.results[0].toObjectId }}"
          },
          "matchingColumns": [
            "hubspot_comapny_id"
          ],
          "schema": [
            {
              "id": "hubspot_comapny_id",
              "displayName": "hubspot_comapny_id",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "canBeUsedToMatch": true,
              "type": "number",
              "removed": false
            }
          ],
          "attemptToConvertTypes": false,
          "convertFieldsToString": true
        },
        "options": {}
      },
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.3,
      "position": [
        -128,
        128
      ],
      "id": "df4b5183-9091-42f9-9898-d848f3e09eab",
      "name": "Upsert Company in Simpro",
      "notesInFlow": true,
      "notes": "Calls [SPL] Upsert Company in Simpro for the contact's first associated company and returns its Simpro customer ID. Field name hubspot_comapny_id (sic) matches the sub-workflow."
    },
    {
      "parameters": {
        "method": "={{ $('Get HubSpot Contact').first().json.properties.simpro_contact_id ? 'PATCH' : 'POST' }}",
        "url": "={{ $('Workflow Config').first().json.simproCustomersUrl }}/{{ $('Upsert Company in Simpro').first().json.simpro_id }}/contacts/{{ $('Get HubSpot Contact').first().json.properties.simpro_contact_id ?? '' }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "oAuth2Api",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ (() => {\n  const c = $('Get HubSpot Contact').first().json.properties;\n  return {\n    GivenName: c.firstname || '',\n    FamilyName: c.lastname || '',\n    Email: c.email || '',\n    WorkPhone: c.phone || '',\n    Title: c.salutation || '',\n    Department: c.department || '',\n    Position: c.jobtitle || '',\n  };\n})() }}",
        "options": {}
      },
      "id": "6470c152-811f-459d-a90e-53d361e8d1ef",
      "name": "Create or Update Simpro Contact",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        96,
        128
      ],
      "notesInFlow": true,
      "alwaysOutputData": true,
      "credentials": {
        "oAuth2Api": {
          "id": "71p2Ps2oLXhe27mr",
          "name": "SPL Simpro"
        }
      },
      "notes": "One node for both paths: PATCH if the HubSpot Contact has simpro_contact_id, otherwise POST under the Simpro customer. EDIT HERE to change fields. Blank HubSpot values are sent as empty strings (as before). Not retried (create)."
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "={{ $('Workflow Config').first().json.hubspotContactsUrl }}/{{ $('When Executed by Another Workflow').first().json.hubspot_contact_id }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "hubspotAppToken",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ ({ properties: { simpro_contact_id: String($('Create or Update Simpro Contact').first().json.ID ?? $('Get HubSpot Contact').first().json.properties.simpro_contact_id) } }) }}",
        "options": {}
      },
      "id": "f138adcd-8650-4d95-b24c-58f75ec30afd",
      "name": "Save Simpro ID To HubSpot Contact",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        304,
        128
      ],
      "notesInFlow": true,
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000,
      "credentials": {
        "hubspotAppToken": {
          "id": "YLZLsLfN752HplsL",
          "name": "SPL Account"
        }
      },
      "notes": "Stamps the Simpro contact ID on the HubSpot Contact so the next run updates instead of creating. Runs on every pass; writing an unchanged value is a no-op. Idempotent PATCH."
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "4f68dece-4a16-494b-a3c3-ca90333c0548",
              "name": "simpro_id",
              "value": "={{ $('Create or Update Simpro Contact').first().json.ID ?? $('Get HubSpot Contact').first().json.properties.simpro_contact_id }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "79147447-8dba-41e9-b8cc-8fb1127acde2",
      "name": "Return Simpro Contact ID",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        512,
        128
      ],
      "notesInFlow": true,
      "notes": "Final output to the parent: { simpro_id }."
    }
